# Onboard Buddy Application - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================
# Database Configuration
# ============================================================
DB_URL=jdbc:mysql://localhost:3306/onboard_buddy?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=appuser
DB_PASSWORD=change_this_password_in_production
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Connection Pool Configuration
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# ============================================================
# Server Configuration
# ============================================================
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/
SERVER_MAX_THREADS=200
SERVER_MIN_SPARE_THREADS=10

# ============================================================
# JWT Configuration
# IMPORTANT: Generate a strong secret key (min 256 bits)
# Use: openssl rand -base64 64
# ============================================================
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_MIN_256_BITS_REQUIRED_USE_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=onboard-buddy-app

# ============================================================
# CORS Configuration
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================================
# File Upload Configuration
# ============================================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_DIRECTORY=/var/onboard-buddy/uploads
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# ============================================================
# Session Configuration
# ============================================================
SESSION_TIMEOUT=1800
SESSION_MAX_CONCURRENT=3
SESSION_CLEANUP_INTERVAL=300

# ============================================================
# Logging Configuration
# ============================================================
LOGGING_LEVEL=INFO
LOGGING_FILE=/var/log/onboard-buddy/application.log
LOGGING_MAX_FILE_SIZE=10MB
LOGGING_MAX_HISTORY=30

# ============================================================
# Email Configuration (Optional)
# ============================================================
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@onboardbuddy.com

# ============================================================
# Application Configuration
# ============================================================
APP_NAME=Onboard Buddy
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:8080

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true
PASSWORD_EXPIRATION_DAYS=90
PASSWORD_HISTORY_COUNT=5

# Buddy Matching
MATCHING_ALGORITHM=skill-based
MATCHING_SCORE_THRESHOLD=0.7

# Notifications
NOTIFICATION_ENABLED=true
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_RETRY_ATTEMPTS=3

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_LOGIN_ATTEMPTS=20
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Security
CSRF_ENABLED=true
CSRF_TOKEN_VALIDITY=3600
